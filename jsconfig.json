{
  // Type checking for plain JavaScript — no build step, no .ts files, nothing
  // emitted. `npm run typecheck` runs tsc in --noEmit mode purely to report
  // mistakes, and the editor uses the same settings so the feedback matches.
  //
  // The important setting is checkJs: false. Checking is OPT-IN per file, via a
  // "// @ts-check" comment at the top. Turning it on repository-wide would
  // produce hundreds of errors at once and the only practical response would be
  // to switch it back off; opting in file by file means every file that carries
  // the comment is genuinely clean, and the set only grows.
  //
  // Everything outside test/ is now opted in — 80 files, zero errors. The
  // second wave (config/, db/, queue/, routes/, scripts/, server.js) cost five
  // fixes, and every one of them turned an undocumented assumption into a
  // stated one rather than silencing a symptom:
  //
  //   * two `unhandledRejection` handlers read `err.stack` off a value that can
  //     be anything a promise was rejected with — they printed "undefined" for
  //     a rejected string, losing the only notice of it;
  //   * the EADDRINUSE retry reads `.code`, which lives on Node's errno subtype
  //     and not on the Error the 'error' event is declared with;
  //   * passport-google-oauth20 is CommonJS with `module.exports = Strategy`, so
  //     the default import is the constructor and the named one is what NodeNext
  //     refuses (both reach the same object at runtime);
  //   * multer ships no declarations at all — see types/multer.d.ts.
  //
  // Keep it that way: a new file gets "// @ts-check" at the top when it is
  // written, not later.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // The package is "type": "module", so this has to match or every relative
    // import with a .js extension is reported as unresolvable.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    // Off for now. The value in this first pass is catching wrong property
    // names and wrong argument counts; turning strict on would bury those under
    // null-check noise on code that has been running correctly for months.
    "strict": false,
    "noImplicitAny": false,
    // Third-party .d.ts files are not ours to fix, and checking them adds
    // seconds to every run for errors nobody here can act on.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "lib/**/*.js",
    "middleware/**/*.js",
    "sockets/**/*.js",
    "app.js",
    "server.js",
    "config/**/*.js",
    "services/**/*.js",
    "controllers/**/*.js",
    "db/**/*.js",
    "queue/**/*.js",
    "routes/**/*.js",
    "scripts/**/*.js",
    // Declaration files only — see types/socket-io.d.ts for what and why.
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "uploads", "dist"]
}
