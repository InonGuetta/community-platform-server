DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET=community-platform-media
PORT=3001

# Used only by `npm run seed`, to create the first admin. No default: the seed
# refuses to run without it rather than falling back to a value in the repo.
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@community.local

# Largest accepted upload, in bytes. Defaults to 2GB (the previous hard-coded
# value). Uploads stream to disk, so the limit is about free space in uploads/,
# not memory.
MAX_UPLOAD_BYTES=2147483648

# Queue tuning. Transcription defaults to NO automatic retry on purpose: a job
# has no checkpointing, so a retry re-runs (and re-pays for) every Whisper call
# from the start. The LLM job is cheap and idempotent, so it does retry.
TRANSCRIPTION_ATTEMPTS=1
LLM_ATTEMPTS=3
# Backstop for a wedged job, not a schedule — well above any real run.
JOB_TIMEOUT_MS=14400000
# How long a worker waits for its current job before exiting on SIGTERM.
WORKER_SHUTDOWN_GRACE_MS=600000

# Exit after an uncaughtException so a supervisor can start a clean process.
# Leave false unless the server runs under pm2/systemd/Docker WITH a restart
# backoff — see the "Running under a supervisor" section in README.md.
EXIT_ON_UNCAUGHT=false
